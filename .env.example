# Node.js 24+. Copy this file to .env for local development; never commit .env.
PORT=3000
HOST=127.0.0.1

# Optional: change API target for the Vite development proxy.
# API_TARGET=http://127.0.0.1:3000

# Private administrator hash + drafts. Back up both this directory and DOCS_DIR.
# DATA_DIR=./server/data
# DOCS_DIR=./server/document

# npm start enables Secure cookies and requires HTTPS APP_ORIGIN.
# APP_ORIGIN=https://blog.example.com
# HOST=0.0.0.0
# Behind a local, trusted reverse proxy only (forward Host and X-Forwarded-Proto).
# TRUST_PROXY=loopback

# Do not store ADMIN_PASSWORD here. Use the hidden prompt: npm run admin:setup
